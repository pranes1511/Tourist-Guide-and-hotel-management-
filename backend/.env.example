# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Replace with your local MongoDB URI or MongoDB Atlas URI:
# Local: mongodb://127.0.0.1:27017/tourist_guide_db
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/tourist_guide_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/tourist_guide_db

# JWT Secret Key for Authentication
JWT_SECRET=tourist_guide_super_secret_jwt_key_2026

# Hotel Manager Registration Secret Code
# Normal tourists cannot become Hotel Managers without providing this verification code
MANAGER_SECRET_CODE=HOTEL_MANAGER_SECURE_2026

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
